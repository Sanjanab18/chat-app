#1 Create folder inside code inside that folder create your v1 ,v2,v3 as your subfolders.
#Open v1
git init
git add .
git commit -m "first commit"
git branch -M v1
git remote add origin https://github.com/Sanjanab18/chat-app.git
git push -u origin v1
#2 open Jenkins create new item choose pipeline click ok.
#Scroll to pipeline script
pipeline {
    agent any

    stages {

        stage('Clone from GitHub') {
            steps {
                git branch: 'v1', url: 'https://github.com/Sanjanab18/chat-app.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Chat App v1...'
            }
        }

    }
}
#Give build now
#3 go to vs code create a file called “Dockerfile”
FROM nginx:alpine
COPY . /usr/share/nginx/html
#In vs code terminal 
docker build -t sahaana18/chat-v1-app .  # docker build -t username/any name .
docker push sahaana18/chat-v1-app
#create deployment,yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cha-v1-deployment (# any-name-deployment)
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cha-v1-app (# strictly your image name)
  template:
    metadata:
      labels:
        app: cha-v1-app
    spec:
      containers:
      - name: cha-v1-container (# any-name-container)
        image: sanjana559/cha-v1-app (# docker username/image name)
        ports:
        - containerPort: 80

# in terminal put these commands
kubectl apply -f v1-deployment.yaml  (#kubectl apply -f filename)




#create service.yaml
apiVersion: v1
kind: Service
metadata:
  name: cha-v1-service (# any-name-service)
spec:
  type: NodePort
  selector:
    app: cha-v1-app (# image name)
  ports:
  - protocol: TCP
    port: 80
    targetPort: 80
    nodePort: 30011
# in terminal put these commands
kubectl apply -f v1-deployment.yaml
kubectl apply -f v1-service.yaml
kubectl get services
kubectl port-forward service/chat-v1-service 30011:80
(#kubectl port-forward service/service-name 30011:80)
# open browser and paste this
http://localhost:30011
